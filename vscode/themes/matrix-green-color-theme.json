  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#60b875", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#77c88a" }
    },
    {
      "name": "String escapes and regex",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#8fffd2" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.other", "variable.other.constant"],
      "settings": { "foreground": "#8fffd2" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "#00ff66" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.separator.key-value"],
      "settings": { "foreground": "#00ff66" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#66ff99" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#b8ffd0" }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter", "meta.definition.variable"],
      "settings": { "foreground": "#d9ffe5" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "support.variable.property", "meta.property-name"],
      "settings": { "foreground": "#b8ffd0" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#77c88a" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#00ff66" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#8fffd2" }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#66ff99", "fontStyle": "bold" }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#00ff66" }
    },
    {
      "name": "Markup code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#8fffd2" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#b8ffd0",
    "class": "#b8ffd0",
    "interface": "#b8ffd0",
    "enum": "#b8ffd0",
    "type": "#b8ffd0",
    "typeParameter": "#8fffd2",
    "function": "#66ff99",
    "method": "#66ff99",
    "macro": "#8fffd2",
    "parameter": "#d9ffe5",
    "variable": "#d9ffe5",
    "property": "#b8ffd0",
    "enumMember": "#8fffd2",
    "decorator": "#8fffd2",
    "keyword": "#00ff66",
    "comment": { "foreground": "#60b875", "italic": true },
    "string": "#77c88a",
    "number": "#8fffd2",
    "regexp": "#8fffd2",
    "operator": "#00ff66"
  }
}
